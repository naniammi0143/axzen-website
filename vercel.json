{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "seller.axzen.in"
        }
      ],
      "destination": "/seller.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.axzen.in"
        }
      ],
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "api.axzen.in"
        }
      ],
      "destination": "/api",
      "permanent": false
    },
    {
      "source": "/register",
      "has": [
        {
          "type": "host",
          "value": "seller.axzen.in"
        }
      ],
      "destination": "/seller-register.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/package.json",
      "destination": "/api/not-found"
    },
    {
      "source": "/package-lock.json",
      "destination": "/api/not-found"
    },
    {
      "source": "/vercel.json",
      "destination": "/api/not-found"
    },
    {
      "source": "/src/(.*)",
      "destination": "/api/not-found"
    },
    {
      "source": "/tests/(.*)",
      "destination": "/api/not-found"
    },
    {
      "source": "/docs/(.*)",
      "destination": "/api/not-found"
    },
    {
      "source": "/scripts/(.*)",
      "destination": "/api/not-found"
    },
    {
      "source": "/server.js",
      "destination": "/api/not-found"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/seller",
      "destination": "/seller.html"
    },
    {
      "source": "/seller/register",
      "destination": "/seller-register.html"
    },
    {
      "source": "/register",
      "destination": "/seller-register.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
